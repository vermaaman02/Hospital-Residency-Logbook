model EntryRevision {
  id           String                 @id @default(cuid())
  entityType   String
  entityId     String
  ownerId      String
  version      Int
  kind         EntryRevisionKind

  snapshot     Json?
  attachments  String[]               @default([])
  submittedAt  DateTime?

  reviewerId   String?
  reviewerRole String?
  decision     EntryRevisionDecision?
  remark       String?

  createdAt    DateTime               @default(now())

  owner        User                   @relation("EntryRevisionsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer     User?                  @relation("EntryRevisionsReviewed", fields: [reviewerId], references: [id])

  @@index([entityType, entityId, version])
  @@index([ownerId])
  @@index([reviewerId])
  @@index([entityType, ownerId])
}

enum EntryRevisionKind {
  SUBMISSION
  REVIEW
}

enum EntryRevisionDecision {
