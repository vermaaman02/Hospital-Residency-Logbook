generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                                @id @default(cuid())
  clerkId                    String                                @unique
  email                      String                                @unique
  firstName                  String
  lastName                   String
  role                       Role                                  @default(STUDENT)
  batch                      String?
  currentSemester            Int?                                  @default(1)
  department                 String?                               @default("Emergency Medicine")
  profileImage               String?
  createdAt                  DateTime                              @default(now())
  updatedAt                  DateTime                              @updatedAt
  banReason                  String?
  bannedUntil                DateTime?
  batchId                    String?
  status                     UserStatus                            @default(ACTIVE)
  notificationsLastSeenAt    DateTime?
  departmentId               String?
  assessmentEvaluations      AssessmentEvaluation[]                @relation("AssessmentEvaluations")
  assessmentSubmissions      AssessmentSubmission[]                @relation("AssessmentSubmissions")
  attendanceSheets           AttendanceSheet[]
  badNewsLogs                BadNewsLog[]
  caseManagementLogs         CaseManagementLog[]
  casePresentations          CasePresentation[]
  clinicalSkillsAdult        ClinicalSkillAdult[]
  clinicalSkillsPediatric    ClinicalSkillPediatric[]
  conferenceParticipation    ConferenceParticipation[]
  consentLogs                ConsentLog[]
  coursesAttended            CourseAttended[]
  diagnosticSkills           DiagnosticSkill[]
  signedEntries              DigitalSignature[]
  disasterDrills             DisasterDrill[]
  facultyBatchAssignments    FacultyBatchAssignment[]              @relation("FacultyBatchAssignments")
  assignedStudents           FacultyStudentAssignment[]            @relation("FacultyAssignments")
  assignedFaculty            FacultyStudentAssignment[]            @relation("StudentAssignments")
  imagingLogs                ImagingLog[]
  assignedFacultyAssessments InternalAssessment[]                  @relation("AssessmentAssignedFaculty")
  assessmentsCreated         InternalAssessment[]                  @relation("AssessmentsCreated")
  journalClubs               JournalClub[]
  logbookFacultyReviews      LogbookFacultyReview[]
  procedureLogs              ProcedureLog[]
  qualityImprovement         QualityImprovement[]
  researchActivities         ResearchActivity[]
  evaluations                ResidentEvaluation[]
  rotationPostings           RotationPosting[]
  rotationStudentConfigs     RotationPostingStudentConfiguration[]
  seminars                   Seminar[]
  thesis                     Thesis?
  trainingMentoringRecords   TrainingMentoringRecord[]
  transportLogs              TransportLog[]
  entryRevisionsOwned        EntryRevision[]                       @relation("EntryRevisionsOwned")
  entryRevisionsReviewed     EntryRevision[]                       @relation("EntryRevisionsReviewed")
  batchRelation              Batch?                                @relation(fields: [batchId], references: [id])
  departmentRelation         Department?                           @relation(fields: [departmentId], references: [id])
  specificAssessments        InternalAssessment[]                  @relation("AssessmentAssignedSpecificStudents")

  @@index([clerkId])
  @@index([role])
  @@index([status])
  @@index([batchId])
  @@index([departmentId])
}

model Batch {
  id                     String                                @id @default(cuid())
  name                   String                                @unique
  currentSemester        Int                                   @default(1)
  startDate              DateTime
  endDate                DateTime?
  isActive               Boolean                               @default(true)
  description            String?
  createdAt              DateTime                              @default(now())
  updatedAt              DateTime                              @updatedAt
  attendanceConfig       AttendanceConfig?
  attendanceHolidays     AttendanceHoliday[]
  departmentBatches      DepartmentBatch[]
  facultyAssignments     FacultyBatchAssignment[]
  assessments            InternalAssessment[]
  rotationConfigs        RotationPostingConfiguration[]
  rotationStudentConfigs RotationPostingStudentConfiguration[]
  students               User[]

  @@index([isActive])
}

model FacultyBatchAssignment {
  id        String   @id @default(cuid())
  facultyId String
  batchId   String
  createdAt DateTime @default(now())
  batch     Batch    @relation(fields: [batchId], references: [id])
  faculty   User     @relation("FacultyBatchAssignments", fields: [facultyId], references: [id])

  @@unique([facultyId, batchId])
  @@index([facultyId])
  @@index([batchId])
}

model FacultyStudentAssignment {
  id        String   @id @default(cuid())
  facultyId String
  studentId String
  semester  Int
  createdAt DateTime @default(now())
  faculty   User     @relation("FacultyAssignments", fields: [facultyId], references: [id])
  student   User     @relation("StudentAssignments", fields: [studentId], references: [id])

  @@unique([facultyId, studentId, semester])
  @@index([facultyId])
  @@index([studentId])
}

model DigitalSignature {
  id         String   @id @default(cuid())
  signedById String
  entityType String
  entityId   String
  remark     String?
  signedAt   DateTime @default(now())
  signedBy   User     @relation(fields: [signedById], references: [id])

  @@index([entityType, entityId])
  @@index([signedById])
}

model HodAutoReviewSetting {
  id          String   @id @default(cuid())
  category    String   @unique
  enabled     Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RotationPosting {
  id            String      @id @default(cuid())
  userId        String
  slNo          Int
  rotationName  String
  isElective    Boolean     @default(false)
  startDate     DateTime?
  endDate       DateTime?
  totalDuration String?
  status        EntryStatus @default(DRAFT)
  facultyRemark String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  durationDays  Int?
  facultyId     String?
  attachments   String[]    @default([])
  user          User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([facultyId])
  @@index([status])
}

model RotationPostingConfiguration {
  id           String     @id @default(cuid())
  rotationSlNo Int
  batchId      String
  semester     Int
  departmentId String
  isEnabled    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  batch        Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([rotationSlNo, batchId, semester, departmentId])
  @@index([batchId])
  @@index([departmentId])
  @@index([semester])
  @@index([isEnabled])
}

model RotationPostingStudentConfiguration {
  id           String     @id @default(cuid())
  rotationSlNo Int
  batchId      String
  semester     Int
  departmentId String
  studentId    String
  isEnabled    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  batch        Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([rotationSlNo, batchId, semester, departmentId, studentId], map: "RotationPostingStudentConfiguration_rotationSlNo_batchId_semes_")
  @@index([batchId])
  @@index([departmentId])
  @@index([semester])
  @@index([studentId])
  @@index([isEnabled])
}

model Thesis {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  topic           String?
  chiefGuide      String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  facultyRemark   String?
  status          EntryStatus            @default(DRAFT)
  user            User                   @relation(fields: [userId], references: [id])
  semesterRecords ThesisSemesterRecord[]
}

model ThesisSemesterRecord {
  id            String      @id @default(cuid())
  thesisId      String
  semester      Int
  srJrMember    String?
  srMember      String?
  facultyMember String?
  createdAt     DateTime    @default(now())
  facultyRemark String?
  status        EntryStatus @default(DRAFT)
  updatedAt     DateTime    @updatedAt
  thesis        Thesis      @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@index([thesisId])
  @@index([status])
}

model AttendanceConfig {
  id                      String   @id @default(cuid())
  batchId                 String   @unique
  batchStartDate          DateTime
  batchEndDate            DateTime
  classStartTime          String
  classEndTime            String
  locationEnabled         Boolean  @default(false)
  locationLatitude        Float?
  locationLongitude       Float?
  locationRadiusMeters    Int?     @default(500)
  weeklyOffDays           String[] @default([])
  minimumAttendancePct    Float    @default(75.0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  faceRecognitionEnabled  Boolean  @default(false)
  manualAttendanceEnabled Boolean  @default(true)
  batch                   Batch    @relation(fields: [batchId], references: [id])

  @@index([batchId])
}

model AttendanceHoliday {
  id        String   @id @default(cuid())
  date      DateTime
  name      String
  batchId   String?
  createdAt DateTime @default(now())
  batch     Batch?   @relation(fields: [batchId], references: [id])

  @@unique([date, batchId])
  @@index([batchId])
  @@index([date])
}

model AttendanceSheet {
  id               String            @id @default(cuid())
  userId           String
  weekStartDate    DateTime
  weekEndDate      DateTime
  batch            String?
  postedDepartment String?
  status           EntryStatus       @default(DRAFT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  facultyRemark    String?
  entries          AttendanceEntry[]
  user             User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([weekStartDate])
}

model AttendanceEntry {
  id                String          @id @default(cuid())
  attendanceSheetId String
  date              DateTime?
  day               DayOfWeek
  presentAbsent     String?
  hodName           String?
  latitude          Float?
  longitude         Float?
  markedAt          DateTime?
  withinLocation    Boolean?
  createdAt         DateTime        @default(now())
  facultyRemark     String?
  signedAt          DateTime?
  signedBy          String?
  status            EntryStatus     @default(DRAFT)
  updatedAt         DateTime        @updatedAt
  attendanceSheet   AttendanceSheet @relation(fields: [attendanceSheetId], references: [id], onDelete: Cascade)

  @@index([attendanceSheetId])
  @@index([date])
  @@index([status])
}

model CasePresentation {
  id                String           @id @default(cuid())
  userId            String
  slNo              Int
  date              DateTime?
  completeDiagnosis String?
  category          PatientCategory?
  facultyRemark     String?
  status            EntryStatus      @default(DRAFT)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  facultyId         String?
  patientAge        String?
  patientName       String?
  patientSex        String?
  uhid              String?
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model Seminar {
  id                String           @id @default(cuid())
  userId            String
  slNo              Int
  date              DateTime?
  completeDiagnosis String?
  category          PatientCategory?
  facultyRemark     String?
  status            EntryStatus      @default(DRAFT)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  facultyId         String?
  patientAge        String?
  patientName       String?
  patientSex        String?
  uhid              String?
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model JournalClub {
  id             String      @id @default(cuid())
  userId         String
  slNo           Int
  date           DateTime?
  journalArticle String?
  typeOfStudy    String?
  facultyRemark  String?
  status         EntryStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  facultyId      String?
  user           User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model ClinicalSkillAdult {
  id                      String           @id @default(cuid())
  userId                  String
  slNo                    Int
  skillName               String
  representativeDiagnosis String?
  confidenceLevel         ConfidenceLevel?
  totalTimesPerformed     Int              @default(0)
  status                  EntryStatus      @default(DRAFT)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  facultyId               String?
  facultyRemark           String?
  user                    User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model ClinicalSkillPediatric {
  id                      String           @id @default(cuid())
  userId                  String
  slNo                    Int
  skillName               String
  representativeDiagnosis String?
  confidenceLevel         ConfidenceLevel?
  totalTimesPerformed     Int              @default(0)
  status                  EntryStatus      @default(DRAFT)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  facultyId               String?
  facultyRemark           String?
  user                    User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model CaseManagementLog {
  id                String           @id @default(cuid())
  userId            String
  category          CaseCategory
  slNo              Int
  caseSubCategory   String
  date              DateTime?
  completeDiagnosis String?
  competencyLevel   CompetencyLevel?
  totalCaseTally    Int              @default(0)
  status            EntryStatus      @default(DRAFT)
  facultyRemark     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  facultyId         String?
  patientAge        Int?
  patientName       String?
  patientSex        String?
  uhid              String?
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([facultyId])
}

model ProcedureLog {
  id                   String            @id @default(cuid())
  userId               String
  procedureCategory    ProcedureCategory
  slNo                 Int
  date                 DateTime?
  completeDiagnosis    String?
  procedureDescription String?
  performedAtLocation  String?
  skillLevel           SkillLevel?
  status               EntryStatus       @default(DRAFT)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  facultyId            String?
  facultyRemark        String?
  patientAge           Int?
  patientName          String?
  patientSex           String?
  totalProcedureTally  Int               @default(0)
  uhid                 String?
  user                 User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([procedureCategory])
  @@index([status])
  @@index([facultyId])
}

model DiagnosticSkill {
  id                      String             @id @default(cuid())
  userId                  String
  diagnosticCategory      DiagnosticCategory
  slNo                    Int
  skillName               String
  representativeDiagnosis String?
  confidenceLevel         ConfidenceLevel?
  totalTimesPerformed     Int                @default(0)
  status                  EntryStatus        @default(DRAFT)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  facultyId               String?
  facultyRemark           String?
  imageUrls               String[]           @default([])
  user                    User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([diagnosticCategory])
  @@index([status])
}

model ImagingLog {
  id                   String          @id @default(cuid())
  userId               String
  imagingCategory      ImagingCategory
  slNo                 Int
  date                 DateTime?
  completeDiagnosis    String?
  procedureDescription String?
  performedAtLocation  String?
  skillLevel           SkillLevel?
  status               EntryStatus     @default(DRAFT)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  facultyId            String?
  facultyRemark        String?
  patientAge           Int?
  patientName          String?
  patientSex           String?
  totalProcedureTally  Int             @default(0)
  uhid                 String?
  imageUrls            String[]        @default([])
  user                 User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([imagingCategory])
  @@index([status])
  @@index([facultyId])
}

model TransportLog {
  id                   String      @id @default(cuid())
  userId               String
  slNo                 Int
  date                 DateTime?
  completeDiagnosis    String?
  procedureDescription String?
  performedAtLocation  String?
  skillLevel           SkillLevel?
  status               EntryStatus @default(DRAFT)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  facultyId            String?
  facultyRemark        String?
  patientAge           Int?
  patientName          String?
  patientSex           String?
  totalProcedureTally  Int         @default(0)
  uhid                 String?
  user                 User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model ConsentLog {
  id                   String      @id @default(cuid())
  userId               String
  slNo                 Int
  date                 DateTime?
  completeDiagnosis    String?
  procedureDescription String?
  performedAtLocation  String?
  skillLevel           SkillLevel?
  status               EntryStatus @default(DRAFT)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  facultyId            String?
  facultyRemark        String?
  patientAge           Int?
  patientName          String?
  patientSex           String?
  totalProcedureTally  Int         @default(0)
  uhid                 String?
  user                 User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model BadNewsLog {
  id                   String      @id @default(cuid())
  userId               String
  slNo                 Int
  date                 DateTime?
  completeDiagnosis    String?
  procedureDescription String?
  performedAtLocation  String?
  skillLevel           SkillLevel?
  status               EntryStatus @default(DRAFT)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  facultyId            String?
  facultyRemark        String?
  patientAge           Int?
  patientName          String?
  patientSex           String?
  totalProcedureTally  Int         @default(0)
  uhid                 String?
  user                 User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model CourseAttended {
  id              String      @id @default(cuid())
  userId          String
  slNo            Int
  date            DateTime?
  courseName      String?
  conductedAt     String?
  confidenceLevel String?
  status          EntryStatus @default(DRAFT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  facultyId       String?
  facultyRemark   String?
  user            User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model ConferenceParticipation {
  id                String      @id @default(cuid())
  userId            String
  slNo              Int
  date              DateTime?
  conferenceName    String?
  conductedAt       String?
  participationRole String?
  status            EntryStatus @default(DRAFT)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  facultyId         String?
  facultyRemark     String?
  user              User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model ResearchActivity {
  id                String      @id @default(cuid())
  userId            String
  slNo              Int
  date              DateTime?
  activity          String?
  conductedAt       String?
  participationRole String?
  status            EntryStatus @default(DRAFT)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  facultyId         String?
  facultyRemark     String?
  user              User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model DisasterDrill {
  id             String      @id @default(cuid())
  userId         String
  slNo           Int
  date           DateTime?
  description    String?
  roleInActivity String?
  status         EntryStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  facultyId      String?
  facultyRemark  String?
  user           User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model QualityImprovement {
  id             String      @id @default(cuid())
  userId         String
  slNo           Int
  date           DateTime?
  description    String?
  roleInActivity String?
  status         EntryStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  facultyId      String?
  facultyRemark  String?
  user           User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model LogbookFacultyReview {
  id             String      @id @default(cuid())
  userId         String
  slNo           Int
  reviewNo       String?
  date           DateTime?
  description    String?
  roleInActivity String?
  facultyId      String?
  facultyRemark  String?
  status         EntryStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([facultyId])
}

model ResidentEvaluation {
  id                   String      @id @default(cuid())
  userId               String
  semester             Int
  reviewNo             Int
  knowledgeScore       Int?
  clinicalSkillScore   Int?
  proceduralSkillScore Int?
  softSkillScore       Int?
  researchScore        Int?
  theoryMarks          String?
  practicalMarks       String?
  description          String?
  roleInActivity       String?
  facultyRemark        String?
  status               EntryStatus @default(DRAFT)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  assignedFacultyId    String?
  user                 User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([semester])
  @@index([status])
  @@index([assignedFacultyId])
}

model TrainingMentoringRecord {
  id                   String      @id @default(cuid())
  userId               String
  semester             Int
  remarks              String?
  status               EntryStatus @default(DRAFT)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  clinicalSkillScore   Int?
  evaluatedById        String?
  knowledgeScore       Int?
  overallScore         Float?
  proceduralSkillScore Int?
  researchScore        Int?
  softSkillScore       Int?
  practicalMarks       String?
  theoryMarks          String?
  user                 User        @relation(fields: [userId], references: [id])

  @@unique([userId, semester])
  @@index([userId])
  @@index([evaluatedById])
  @@index([status])
}

model InternalAssessment {
  id                String                 @id @default(cuid())
  title             String
  description       String?
  assessmentType    AssessmentType         @default(OTHER)
  batchId           String
  createdById       String
  deadline          DateTime?
  resourceLinks     String[]
  maxMarks          Int?
  totalMarks        Float?
  isPublished       Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  publishAt         DateTime?
  semester          Int?
  assignedFacultyId String?
  attachments       String[]               @default([])
  submissions       AssessmentSubmission[]
  assignedFaculty   User?                  @relation("AssessmentAssignedFaculty", fields: [assignedFacultyId], references: [id])
  batch             Batch                  @relation(fields: [batchId], references: [id])
  createdBy         User                   @relation("AssessmentsCreated", fields: [createdById], references: [id])
  assignedStudents  User[]                 @relation("AssessmentAssignedSpecificStudents")

  @@index([batchId])
  @@index([createdById])
  @@index([isPublished])
  @@index([assignedFacultyId])
}

model AssessmentSubmission {
  id           String                @id @default(cuid())
  assessmentId String
  studentId    String
  content      String?
  submittedAt  DateTime?
  status       EntryStatus           @default(DRAFT)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  attachments  String[]              @default([])
  evaluation   AssessmentEvaluation?
  assessment   InternalAssessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      User                  @relation("AssessmentSubmissions", fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
  @@index([status])
}

model AssessmentEvaluation {
  id              String               @id @default(cuid())
  submissionId    String               @unique
  evaluatedById   String
  marks           Float?
  grade           String?
  feedback        String?
  rejectionReason String?
  evaluatedAt     DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  isMarksLocked   Boolean              @default(false)
  evaluatedBy     User                 @relation("AssessmentEvaluations", fields: [evaluatedById], references: [id])
  submission      AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([evaluatedById])
}

model Department {
  id                     String                                @id @default(cuid())
  name                   String                                @unique
  code                   String                                @unique
  description            String?
  isActive               Boolean                               @default(true)
  createdAt              DateTime                              @default(now())
  updatedAt              DateTime                              @updatedAt
  departmentBatches      DepartmentBatch[]
  departmentForms        DepartmentForm[]
  rotationConfigs        RotationPostingConfiguration[]
  rotationStudentConfigs RotationPostingStudentConfiguration[]
  users                  User[]

  @@index([isActive])
}

model DepartmentBatch {
  id           String     @id @default(cuid())
  departmentId String
  batchId      String
  createdAt    DateTime   @default(now())
  batch        Batch      @relation(fields: [batchId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, batchId])
  @@index([departmentId])
  @@index([batchId])
}

model FormDefinition {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  description     String?
  category        String?
  icon            String?
  route           String
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  departmentForms DepartmentForm[]

  @@index([isActive])
  @@index([slug])
}

model DepartmentForm {
  id               String         @id @default(cuid())
  departmentId     String
  formDefinitionId String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  department       Department     @relation(fields: [departmentId], references: [id])
  formDefinition   FormDefinition @relation(fields: [formDefinitionId], references: [id])

  @@unique([departmentId, formDefinitionId])
  @@index([departmentId])
  @@index([formDefinitionId])
  @@index([isActive])
}

