# ==============================================================================
# AIIMS Patna PG Residency Digital Logbook — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in the actual values.
# NEVER commit .env or .env.local files to version control.
# ==============================================================================

# ======================== DATABASE ========================
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# ======================== CLERK AUTHENTICATION ========================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your-key-here"
CLERK_SECRET_KEY="sk_test_your-key-here"

# Clerk webhook secret (for user sync webhook)
CLERK_WEBHOOK_SECRET="whsec_your-webhook-secret"

# ======================== CLERK ROUTES ========================
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ======================== APP CONFIG ========================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
